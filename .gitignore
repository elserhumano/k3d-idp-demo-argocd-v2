# Directorios de Terraform locales
.terraform/

# Lock file containing provider hashes
.terraform.lock.hcl

# Archivos de estado (contienen información sensible)
*.tfstate
*.tfstate.*

# Archivos de variables locales (pueden contener contraseñas o tokens)
*.tfvars
!*.tfvars.example

# Registros de errores del sistema
crash.log
crash.*.log

# Archivos de configuración de CLI locales
.terraformrc
terraform.rc

